---

<Layout>
  <HeroSection
    subtitle="Alpa Alumínio"
    title="Soluções em alumínio para diferentes aplicações"
    titleSize="7xl"
    description="Desenvolvemos sistemas em alumínio que unem resistência, versatilidade e alto padrão de acabamento. Encontre a solução ideal para projetos de todos os portes."
    image={heroImg}
    ctaText="Fale com um especialista"
  />
  
  <InfoBar items={infoItems} theme="secondary" />

  <RelatedProductsSection
    eyebrow="Nossos Produtos"
    title="Soluções em alumínio"
    subtitle="Dispomos em nosso catálogo soluções inteligentes e inovadoras para projetos residenciais, comerciais e industriais."
    products={featuredProducts}
    cols={4}
    theme="white"
    titleSize="6xl"
    showMoreButton
    moreProductsLink="/produtos"
    moreProductsLabel="Ver catálogo completo"
  />

  <Categories
    eyebrow="Categorias"
    title="Explore nossa linha em alumínio"
    subtitle="Descubra produtos em alumínio com qualidade, design e durabilidade para cada necessidade do seu projeto."
    categories={categoriesComImagem}
    theme="white"
  />

  <PhotoGallery
    galleryId={`gallery-${Math.random().toString(36).slice(2)}`}
    eyebrow="Projetos que usam Alpa Alumínio"
    title="Sofisticação e funcionalidade para seus projetos"
    subtitle="Nossos produtos oferecem o que há de melhor no mercado de alumínio para todos os padrões de arquitetura. Confira alguns casos de sucesso."
    titleSize="5xl"
    cols={2}
    aspect="16/9"
    headerAlign="center"
    photos={photos}
    theme="surface"
  />

  <VideoSection2
    theme="white"
    eyebrow="O que fazemos"
    title="Conectamos boas escolhas a bons projetos"
    subtitle="A Alpa Alumínio conecta as melhores escolhas em perfis de alumínio para esquadrias, fachadas e revestimentos, garantindo mais qualidade e fluidez na execução do seu projeto."
    titleSize="6xl"
    size="large"
    mp4Src="/videos/apresentacao-alpa.mp4"
    posterSrc="/images/capa-video-alpa.webp"
    aspectRatio="9/16"
    desktopVideoPosition="left"
  />

  <DifferentialsSection
    theme="secondary"
    title="Por que escolher a Alpa Alumínio?"
    titleSize="6xl"
    eyebrow="Por que escolher a Alpa Alumínio?"
    subtitle="Comprometidos com a excelência, inovação e sustentabilidade, oferecemos soluções em alumínio que se destacam pela qualidade, durabilidade e design."
    items={differentials}
  />

  <SocialProofSection
    title="Depoimentos de clientes"
    subtitle="Confira relatos de clientes que confiam nos produtos da Alpa Alumínio"
    eyebrow="Depoimentos"
    titleSize="5xl"
    testimonials={testimonials}
    layout="grid"
    highlightFirst={false}
    theme="surface"
    colsMobile={1}
  />

  <CtaSection
    eyebrow="Fale conosco"
    title="Pronto para transformar seus projetos com soluções em alumínio de alta qualidade?"
    description="Nossa equipe de especialistas está pronta para oferecer consultoria personalizada e soluções sob medida para atender às suas necessidades."
    ctaText="Fale com um especialista"
    whatsappNumber={ctaTarget}
    productName="Alpa Alumínio"
  />


  <ContentSection
    headerAlign="left"
    size="content"
    eyebrow="Alpa Alumínio"
    title="Inovação e Qualidade em Soluções de Alumínio"
    titleSize="6xl"
    subtitle="Há mais de 20 anos atuando no mercado de alumíinio, oferecemos soluções inteligentes e inovadoras para projetos residenciais, comerciais e industriais, sendo capaz de oferecer o que há de melhor para todos os padrões de projetos"
  >
    <div
      class="mt-8 relative aspect-[4/3] md:aspect-[16/9] md:rounded-2xl overflow-hidden group"
    >
      <Image
        src={img1}
        alt="Imagem de um projeto utilizando soluções em alumínio da Alpa Alumínio"
        class="block w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      />
    </div>
  </ContentSection>

</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>("section[data-bg]"),
    );

    sections.forEach((section, i) => {
      const prev = sections[i - 1];
      if (prev && prev.dataset.bg === section.dataset.bg) {
        section.style.paddingTop = "64px";
        prev.style.paddingBottom = "64px";
      }
    });
  });
</script>
