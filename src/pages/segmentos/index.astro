---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";

const segments = await getCollection("segments");
---

<Layout title="Segmentos">
  <section class="container mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold">Segmentos</h1>
    <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {segments.map((seg) => (
        <a href={`/segmentos/${seg.id}`} class="rounded-xl border p-6 hover:shadow transition text-center">
          {seg.data.image && (
            <img src={seg.data.image} alt={seg.data.name} class="mx-auto mb-3 h-12 w-12 object-contain" />
          )}
          <span class="font-medium">{seg.data.name}</span>
        </a>
      ))}
    </div>
  </section>
</Layout>