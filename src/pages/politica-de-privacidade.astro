---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Política de Privacidade"
  description="Política de Privacidade"
>
  <section>
    <div class="bg-primary">
      <div class="max-w-5xl mx-auto px-4 py-20 pt-42 text-center space-y-6">
        <h1
          class="text-4xl lg:text-6xl font-medium tracking-tighter text-white text-balance"
        >
         Política de Privacidade
        </h1>

        <p class="text-lg xl:text-xl text-white max-w-3xl mx-auto">
          Conheça a Política de Privacidade da Alpa
        </p>
      </div>
    </div>

    <div class="container mx-auto px-4 py-16">
        <p>Em breve</p>
    </div>
  </section>
</Layout>
