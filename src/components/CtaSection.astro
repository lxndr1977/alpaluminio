---
import Button from "./ui/Button.astro";
import { getTheme } from "@/lib/section-themes";

import {
  Section,
  SectionContent,
} from "@/components/ui/Section";

import type { SectionBaseProps } from "@/lib/section-props";

interface Props extends SectionBaseProps {
  whatsappNumber: string;
  productName: string;
  description?: string;
  ctaText?: string;
  customMessage?: string;
}

const {
  eyebrow = "Fale Conosco",
  whatsappNumber,
  productName,
  title = "Pronto para Dar o Próximo Passo?",
  description = "Entre em contato agora mesmo para receber um orçamento personalizado e tirar todas as suas dúvidas com nossos especialistas.",
  customMessage,
  paddingTop = "xl",
  paddingBottom = "xl",
  size = "container",
  margin = "none", 
  theme = "white",
  ctaText = "Fale com um especialista",
} = Astro.props;

const themeColor = getTheme(theme);

// WhatsApp link generation logic
const fallbackMessage =
  "Olá! Tenho interesse no produto {productName}. Pode me ajudar?";
const messageTemplate = customMessage || fallbackMessage;
const message = messageTemplate.replace(/\{productName\}/g, productName);

// Handle phone number formatting (keep only digits)
const sanitizedNumber = whatsappNumber.replace(/\D/g, "");
const whatsappUrl = `https://wa.me/${sanitizedNumber}?text=${encodeURIComponent(message)}`;
---

<Section
  theme={theme}
  size={size}
  paddingTop={paddingTop}
  paddingBottom={paddingBottom}
  margin={margin}
>
  {/* Decorative Background Elements */}

  <SectionContent>


  <div
    class="relative max-w-7xl xl:container mx-auto text-center px-6 md:px-8 lg:px-12 py-12 md:py-18 bg-primary to-accent rounded-xl"
    data-animate="fade-up"
  >
    <div
      class="absolute inset-0 pointer-events-none overflow-hidden"
      aria-hidden="true"
    >
      <div
        class="absolute -top-[10%] -right-[5%] w-[45%] h-[90%] bg-primary/10 rounded-full blur-[120px] opacity-70"
      >
      </div>
      <div
        class="absolute -bottom-[10%] -left-[5%] w-[45%] h-[90%] bg-accent/10 rounded-full blur-[120px] opacity-70"
      >
      </div>
    </div>
    {/* Headline Label */}
    <span
      class="inline-block py-1 px-4 text-white text-sm font-bold uppercase tracking-[0.2em] rounded-full mb-4 fade-up"
    >
      {eyebrow}
    </span>

    {/* Title */}
    <h2
      class="max-w-5xl mx-auto text-4xl md:text-3xl lg:text-5xl font-medium text-white tracking-tighter leading-[1.1] mb-6 fade-up delay-1"
    >
      {title}
    </h2>

    {/* Description */}
    <p
      class="text-lg md:text-xl text-white max-w-5xl mx-auto mb-12 leading-relaxed fade-up delay-2"
    >
      {description}
    </p>

    {/* Buttons and Social Proof */}
    <div class="flex flex-col items-center gap-8 fade-up delay-3">
      <div class="relative group">
        {/* Button Animation Wrapper */}

        <Button
          href={whatsappUrl}
          variant="white"
          size="lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="w-5 h-5 mr-2"
            aria-hidden="true"
            ><path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.385-4.437 9.884-9.886 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
            ></path></svg
          >
          {ctaText}
        </Button>
      </div>
    </div>
  </div>
  </SectionContent>

</Section>
