---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import {
  Section,
  SectionHeader,
  SectionEyebrow,
  SectionTitle,
  SectionSubtitle,
  SectionContent,
} from "@/components/ui/Section";
  
import { getTheme } from "@/lib/section-themes";
import type { SectionBaseProps } from "@/lib/section-props";

interface Photo {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  description?: string;
}

interface Props extends SectionBaseProps {
  photos: Photo[];
  cols?: number;
  aspect?: "4/3" | "3/4" | "16/9" | "9/16" | "1/1" | "3/2" | "2/3";
  galleryId: string;
  autoplayDelay?: number;
  loop?: boolean;
  spaceBetween?: number;
}

const {
  photos,
  aspect = "4/3",
  cols: colsProp = 3,
  theme = "white",
  eyebrow,
  title,
  titleSize = "7xl",
  subtitle,
  headerAlign = "left",
  galleryId,
  autoplayDelay = 4000,
  loop = true,
  spaceBetween = 16,
  margin = "none",
  paddingTop = "xl",
  paddingBottom = "xl",
} = Astro.props;

const cols = Math.max(1, colsProp);
const id = `gallery-${galleryId}`;
const themeColor = getTheme(theme);

const getSrc = (src: ImageMetadata | string): string =>
  typeof src === "string" ? src : src.src;
---

<Section theme={theme} size="full" paddingTop={paddingTop} paddingBottom={paddingBottom} margin={margin}>
  <SectionHeader align={headerAlign}>
    <SectionEyebrow color={themeColor.eyebrow}>{eyebrow}</SectionEyebrow>
    <SectionTitle size={titleSize} color={themeColor.title}>{title}</SectionTitle>
    <SectionSubtitle color={themeColor.subtitle}>{subtitle}</SectionSubtitle>
  </SectionHeader>

  <SectionContent direction="col" gap="sm" align="center" size="container">
    <div class="relative w-full">
      <div
        class={`swiper overflow-hidden rounded-lg ${cols === 3 ? "justify-center" : ""}`}
        id={`${id}-swiper`}
        data-gallery-id={id}
        data-gallery-cols={cols}
        data-autoplay-delay={autoplayDelay}
        data-loop={String(loop)}
        data-space-between={spaceBetween}
      >
        <div class="swiper-wrapper rounded-lg">
          {
            photos.map((photo) => (
              <div class="swiper-slide rounded-lg">
                
                <a  href={getSrc(photo.src)}
                  class="glightbox block w-full overflow-hidden rounded-lg"
                  data-gallery={id}
                  data-description={photo.description}
                >
                  {typeof photo.src === "string" ? (
                    <img
                      src={photo.src}
                      alt={photo.alt}
                      class="w-full aspect-img object-cover rounded-lg transition-transform duration-500 hover:scale-105"
                    />
                  ) : (
                    <Image
                      src={photo.src}
                      alt={photo.alt}
                      width={800}
                      height={600}
                      class="w-full aspect-img object-cover rounded-lg transition-transform duration-500 hover:scale-105"
                    />
                  )}
                </a>
              </div>
            ))
          }
        </div>
      </div>

      <button
        id={`${id}-prev`}
        type="button"
        aria-label="Anterior"
        class={`hidden md:flex absolute -left-4 md:-left-6 top-1/2 -translate-y-1/2 z-20 h-12 w-12 items-center justify-center rounded-full border shadow-lg transition-all duration-200 active:scale-95 disabled:opacity-0 ${themeColor.swiper.navButton}`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6"></path>
        </svg>
      </button>

      <button
        id={`${id}-next`}
        type="button"
        aria-label="Próximo"
        class={`hidden md:flex absolute -right-4 md:-right-6 top-1/2 -translate-y-1/2 z-20 h-12 w-12 items-center justify-center rounded-full border shadow-lg transition-all duration-200 active:scale-95 disabled:opacity-0 ${themeColor.swiper.navButton}`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m9 18 6-6-6-6"></path>
        </svg>
      </button>
    </div>

    <div
      id={`${id}-pagination`}
      class="pagination-el mt-1 hidden md:flex items-center justify-center gap-2"
    >
    </div>
  </SectionContent>
</Section>

<style
  define:vars={{
    dotInactive: themeColor.swiper.dotInactive,
    dotActive: themeColor.swiper.dotActive,
    aspect,
  }}
>
  .swiper { padding-bottom: 12px; }
  .swiper-slide { height: auto; }
  .pagination-el :global(.swiper-pagination-bullet) {
    width: 8px;
    height: 8px;
    background-color: var(--dotInactive);
    opacity: 0.5;
    border-radius: 99px;
    transition: all 0.3s;
  }
  .pagination-el :global(.swiper-pagination-bullet-active) {
    width: 28px;
    background-color: var(--dotActive);
    opacity: 1;
  }
  .swiper :global(.aspect-img) { aspect-ratio: var(--aspect); }
</style>

<script>
  import { initGalleries, registerGalleryListeners } from "../scripts/gallery-swiper";
  registerGalleryListeners();
  initGalleries();
</script>