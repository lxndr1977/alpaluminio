---
import { Phone, MessageCircle, Mail, MapPin, Clock } from "@lucide/astro";

interface Props {
  logo?: string;
  menuLinks: { label: string; href: string }[];
  institutionalLinks: { label: string; href: string }[];
  contacts: {
    phone: string;
    whatsapp: string;
    email: string;
    address: string;
    businessHours: string;
  };
  instagram?: string;
  facebook?: string;
  companyName: string;
  cnpj: string;
  year?: number;
}

const {
  logo,
  menuLinks,
  institutionalLinks,
  contacts,
  instagram = "https://instagram.com/alpaaluminio",
  facebook = "https://www.facebook.com/alpaaluminio",
  companyName,
  cnpj,
  year = new Date().getFullYear(),
} = Astro.props;

// Format phone/whatsapp for links (remove non-digits)
const formatPhoneLink = (phone: string) => phone.replace(/\D/g, "");
const whatsappLink = `https://wa.me/${formatPhoneLink(contacts.whatsapp)}`;
---

<footer id="footer" class="bg-dark text-white/90 border-t border-white/5">
  <div class="max-w-7xl xl:container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 py-32">
      <!-- Col 1: Logo & Brand -->
      <div class="flex flex-col gap-6">
        <a href="/" class="flex items-center gap-2 group">
          {
            logo ? (
              <img src={logo} alt={companyName} class="h-10 xl:h-14 w-auto" />
            ) : (
              <>
                <div class="w-8 h-8 bg-primary rounded-sm flex items-center justify-center transform group-hover:rotate-12 transition-transform">
                  <span class="text-white font-bold text-xl uppercase italic">
                    A
                  </span>
                </div>
                <span class="font-black text-xl tracking-tight text-white uppercase italic">
                  ALPA
                </span>
              </>
            )
          }
        </a>
        <p class="text-sm leading-relaxed max-w-xs">
          Referência em qualidade e inovação para soluções em alumínio.
        </p>

        <div class="flex items-center gap-3 mt-10">
          <a
            href={instagram}
            target="_blank"
            aria-label="Instagram"
            class="size-11 rounded-full bg-primary flex items-center justify-center text-white hover:border-primary hover:text-primary transition-colors"
          >
            <svg
              class="size-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              viewBox="0 0 24 24"
            >
              <rect x="2" y="2" width="20" height="20" rx="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>

          <a
            href={facebook}
            target="_blank"
            aria-label="Facebook"
            class="size-11 rounded-full bg-primary flex items-center justify-center text-white hover:border-primary hover:text-primary transition-colors"
          >
            <svg class="size-5" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <h3
          class="text-white font-bold text-lg mb-6 uppercase tracking-wider text-sm"
        >
          Navegação
        </h3>
        <ul class="flex flex-col gap-6">
          {
            menuLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="hover:text-primary inline-block transition-all duration-300"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3: Institutional -->
      <div>
        <h3
          class="text-white font-bold text-lg mb-6 uppercase tracking-wider text-sm"
        >
          Institucional
        </h3>
        <ul class="flex flex-col gap-6">
          {
            institutionalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="hover:text-primary inline-block transition-all duration-300"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 4: Contacts -->
      <div>
        <h3
          class="text-white font-bold text-lg mb-6 uppercase tracking-wider text-sm"
        >
          Atendimento
        </h3>
        <div class="flex flex-col gap-4">
          <a
            href={`tel:${formatPhoneLink(contacts.phone)}`}
            class="flex items-center gap-3 text-lg xl:text-xl font-bold hover:text-primary transition-colors group"
          >
            <Phone size={24} class="text-primary shrink-0" />
            <span>{contacts.phone}</span>
          </a>
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 text-lg xl:text-xl font-bold hover:text-primary transition-colors group"
          >
            <MessageCircle size={24} class="text-primary shrink-0" />
            <span>{contacts.whatsapp}</span>
          </a>
          <a
            href={`mailto:${contacts.email}`}
            class="flex items-center gap-3 hover:text-primary transition-colors group"
          >
            <Mail size={16} class="text-primary shrink-0" />
            <span>{contacts.email}</span>
          </a>
          <div class="flex items-start gap-3 group">
            <MapPin size={16} class="text-primary shrink-0 mt-0.5" />
            <span class="leading-relaxed">{contacts.address}</span>
          </div>
          <div class="flex items-center gap-3 group">
            <Clock size={16} class="text-primary shrink-0" />
            <span>{contacts.businessHours}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Legal Footer -->
    <div class="pt-8 border-t border-white/10 text-center md:text-left">
      <div
        class="flex flex-col md:flex-row justify-between items-center gap-4 text-sm font-medium text-white/40"
      >
        <p>
          CNPJ {cnpj} • {companyName} • © {year} Todos os direitos reservados.
        </p>
        <div class="flex gap-6">
          <a href="/privacidade" class="hover:text-primary transition-colors"
            >Política de Privacidade</a
          >
        </div>
      </div>
    </div>
  </div>
</footer>
