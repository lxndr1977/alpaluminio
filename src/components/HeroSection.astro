---
import Button from "./ui/Button.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import {
  SectionHeader,
  SectionEyebrow,
  SectionTitle,
  SectionSubtitle,
} from "./ui/Section";
import type { SectionBaseProps } from "@/lib/section-props";

interface Props extends SectionBaseProps {
  title: string;
  subtitle?: string;
  description?: string;
  image: string | ImageMetadata;
  ctaText?: string;
  ctaLink?: string;
}
const {
  title,
  subtitle,
  description,
  image,
  ctaText,
  ctaLink,
  titleSize = "8xl",
} = Astro.props;
---

<div
  class="relative !bg-gradient-to-r from-primary via-primary to-accent !text-white min-h-[100vh] flex items-center pt-32 pb-0 md:pb-20 md:pt-40 md:pb-32 overflow-hidden"
>
  <!-- Ribbed aluminum slat pattern -->
  <div class="slat-overlay" aria-hidden="true">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="100%"
      height="100%"
      preserveAspectRatio="xMidYMid slice"
    >
      <defs>
        <linearGradient id="slat-grad" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="black" stop-opacity="0.01"></stop>
          <stop offset="15%" stop-color="white" stop-opacity="0.02"></stop>
          <stop offset="45%" stop-color="white" stop-opacity="0.02"></stop>
          <stop offset="62%" stop-color="white" stop-opacity="0.03"></stop>
          <stop offset="85%" stop-color="white" stop-opacity="0.01"></stop>
          <stop offset="100%" stop-color="black" stop-opacity="0.01"></stop>
        </linearGradient>

        <pattern
          id="slat-pattern"
          x="0"
          y="0"
          width="24"
          height="0.8"
          patternUnits="userSpaceOnUse"
        >
          <rect width="24" height="1" fill="url(#slat-grad)"></rect>
        </pattern>
      </defs>

      <rect width="100%" height="100%" fill="url(#slat-pattern)"></rect>
    </svg>
  </div>

  <!-- Conteúdo com z-index explícito para não ser afetado pelos overlays -->
  <div
    class="relative z-10 w-full max-w-7xl xl:container mx-auto md:px-6 lg:px-8"
  >
    <div
      class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-20 items-center"
    >
      <div class="max-w-3xl fade-up px-4 sm:px-0">
        <SectionHeader align="left" noPadding class="mb-8">
          <SectionEyebrow color="white">{subtitle}</SectionEyebrow>
          <SectionTitle size={titleSize} color="white">{title}</SectionTitle>
          <SectionSubtitle color="white">{description}</SectionSubtitle>
        </SectionHeader>

        <div class="flex flex-wrap gap-5" data-animate="fade-up" data-animate-delay="0.3">
          <Button href="https://wa.me/yournumber" variant="white" size="lg">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5"
              aria-hidden="true"
              ><path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.385-4.437 9.884-9.886 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
              ></path></svg
            >
            {ctaText || "Solicite um orçamento"}
          </Button>
        </div>
      </div>

      <div class="relative fade-up delay-2">
        <div class="relative aspect-[4/3] md:rounded-lg overflow-hidden group">
          {
            typeof image === "string" ? (
              <img
                src={image}
                alt={title}
                class="object-cover w-full h-full transition-transform duration-[2000ms]"
              />
            ) : (
              <Image
                src={image}
                alt={title}
                class="object-cover w-full h-full transition-transform duration-[2000ms]"
              />
            )
          }
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* --- Slat pattern --- */
  .slat-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
</style>
