---
import Button from './ui/Button.astro';

interface Props {
  productName: string;
  productImage: string;
  message?: string;
  subMessage?: string;
  ctaLabel: string;
  ctaTarget: string;
  showAfter?: 'hero' | 'scroll';
}

const {
  productName,
  productImage,
  message,
  subMessage,
  ctaLabel,
  ctaTarget,
  showAfter = 'hero',
} = Astro.props;
---

<div
  id="sticky-bar"
  class="fixed bottom-0 left-0 w-full bg-white border-t border-gray-100 shadow-[0_-10px_40px_rgba(0,0,0,0.1)] z-[100] transform translate-y-full transition-all duration-700 cubic-bezier(0.16, 1, 0.3, 1) pointer-events-none opacity-0"
  data-show-after={showAfter}
  data-cta-target={ctaTarget}
>
  <div class="max-w-7xl mx-auto px-4 py-2.5 sm:py-3 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-4 sm:gap-10">
      <!-- Left side: Product info -->
      <div class="hidden sm:flex items-center gap-3 sm:gap-6 min-w-0">
        <div class="shrink-0">
          <img
            src={productImage}
            alt={productName}
            class="w-14 h-14 object-cover rounded-sm border border-gray-100 shadow-sm"
          />
        </div>
        <div class="min-w-0">
          <p class="text-dark font-bold text-sm sm:text-lg xl:text-xl tracking-tight leading-tight mb-0 sm:mb-0.5 truncate">
            {message || productName}
          </p>
          {subMessage && (
            <p class="text-gray-500 font-medium text-xs sm:text-sm xl:text-base truncate">
              {subMessage}
            </p>
          )}
        </div>
      </div>

      <!-- Right side: CTA -->
      <div class="w-full sm:w-auto flex items-center gap-4">
        <Button 
          id="sticky-cta-btn"
          href={ctaTarget.startsWith('http') || ctaTarget.startsWith('https') || ctaTarget.startsWith('tel:') || ctaTarget.startsWith('mailto:') ? ctaTarget : undefined}
          variant="primary" 
          size="sm" 
          class="w-full sm:w-auto px-5 py-2.5 sm:px-8 sm:py-3 font-bold whitespace-nowrap text-sm sm:text-base"
          target={ctaTarget.startsWith('http') ? "_blank" : undefined}
          rel={ctaTarget.startsWith('http') ? "noopener noreferrer" : undefined}
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 sm:w-5 sm:h-5" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.385-4.437 9.884-9.886 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          {ctaLabel}
        </Button>
      </div>
    </div>
  </div>
</div>

<style>
  #sticky-bar {
    transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>

<script>
  function initStickyBar() {
    const bar = document.getElementById('sticky-bar');
    if (!bar) return;

    const showAfter = bar.dataset.showAfter;
    const ctaTargetId = bar.dataset.ctaTarget;
    const ctaBtn = document.getElementById('sticky-cta-btn');
    const footer = document.getElementById('footer') as HTMLElement;

    let isVisible = false;

    const showBar = () => {
      if (isVisible) return;
      bar.classList.remove('translate-y-full', 'pointer-events-none', 'opacity-0');
      bar.classList.add('translate-y-0', 'opacity-100');
      
      isVisible = true;
      
      footer.classList.add('pb-28');
    };

    const hideBar = () => {
      if (!isVisible) return;
      bar.classList.add('translate-y-full', 'pointer-events-none', 'opacity-0');
      bar.classList.remove('translate-y-0', 'opacity-100');
      isVisible = false;

      footer.classList.remove('pb-28');
    };

    // CTA Button logic for anchors
    if (ctaTargetId && ctaTargetId.startsWith('#')) {
      ctaBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        const targetElement = document.querySelector(ctaTargetId);
        if (targetElement) {
          targetElement.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }

    // Logic for showing the bar
    if (showAfter === 'hero') {
      const hero = document.querySelector('section');
      if (hero) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
              showBar();
            } else {
              hideBar();
            }
          });
        }, { threshold: 0.1 });
        
        observer.observe(hero);
      }
    } else {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 800) {
          showBar();
        } else {
          hideBar();
        }
      }, { passive: true });
    }
  }

  initStickyBar();
  document.addEventListener('astro:after-swap', initStickyBar);
</script>
