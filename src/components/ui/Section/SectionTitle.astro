---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/utils/cn";

type HeadingTag = "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
type HeadingSize =
  | "base"
  | "lg"
  | "xl"
  | "2xl"
  | "3xl"
  | "4xl"
  | "5xl"
  | "6xl"
  | "7xl"
  | "8xl"
  | "9xl";
  
interface Props extends HTMLAttributes<"h2"> {
  as?: HeadingTag;
  size?: HeadingSize;
  color?: "white" | "primary" | "secondary" | "foreground" | "muted" | "surface";
}

const sizeMap: Record<HeadingSize, string> = {
  base: "text-base",
  lg: "text-lg",
  xl: "text-xl",
  "2xl": "text-2xl",
  "3xl": "text-2xl md:text-3xl",
  "4xl": "text-3xl md:text-4xl",
  "5xl": "text-3xl md:text-4xl lg:text-5xl",
  "6xl": "text-4xl md:text-5xl lg:text-6xl",
  "7xl": "text-4xl md:text-6xl lg:text-7xl",
  "8xl": "text-5xl md:text-7xl lg:text-8xl",
  "9xl": "text-5xl md:text-7xl lg:text-9xl"
};

const colorMap: Record<string, string> = {
  white: "text-white",
  primary: "text-primary",
  secondary: "text-secondary",
  foreground: "text-foreground",
  muted: "text-foreground-muted",
  surface: "text-foreground-subtle",
};

const {
  as: Tag = "h2",
  size = "4xl",
  color = "foreground",
  class: className,
  ...rest
} = Astro.props;
---

<Tag
  {...rest}
  class={cn(
    "font-medium  tracking-tighter max-w-4xl text-balance",
    sizeMap[size],
    colorMap[color],
    className,
  )}
>
  <slot />
</Tag>
